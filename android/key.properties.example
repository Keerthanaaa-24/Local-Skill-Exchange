# ==============================================================================
# Android Release Keystore Configuration Template
# ==============================================================================
# 1. Generate a production keystore (run in terminal):
#    keytool -genkey -v -keystore android/app/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to android/key.properties and set your values:
#    (Do NOT commit your real key.properties or upload-keystore.jks to git)
# ==============================================================================

keyAlias=upload
keyPassword=YourStrongKeyPasswordHere
storeFile=upload-keystore.jks
storePassword=YourStrongStorePasswordHere
