# Local Skill Exchange - Environment Variables Example
# Copy this file to .env and replace placeholders with your local environment values

# Database Connection (MySQL)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/local_skill_exchange

# JWT Authentication Secret Key
SECRET_KEY=YOUR_JWT_SECRET_KEY_GOES_HERE

# Google Maps API Key (Optional / Frontend integration)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_GOES_HERE
