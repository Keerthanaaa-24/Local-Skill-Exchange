# Local Skill Exchange - Environment Variables Example
# Copy this file to .env and replace placeholders with your local environment values

# Database Connection (MySQL)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/local_skill_exchange

# JWT Authentication Secret Key
SECRET_KEY=YOUR_JWT_SECRET_KEY_GOES_HERE

# OpenStreetMap & Location Services (Free / No Secrets or Billing Required)
# Custom tile server URL (Defaults to standard OSM tiles: https://tile.openstreetmap.org/{z}/{x}/{y}.png)
# OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Free Geocoding API (Defaults to Photon: https://photon.komoot.io/api)
# GEOCODING_API_URL=https://photon.komoot.io/api

# Free OSRM Routing Machine (Defaults to public demo: https://router.project-osrm.org)
# OSRM_API_URL=https://router.project-osrm.org
