# ==============================================================================
# Local Skill Exchange — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on your cloud server (e.g. Railway, Render, Fly.io, AWS)
# NEVER commit the real .env containing secrets to version control.
# ==============================================================================

# Application Environment (enforces security rules when set to 'production')
ENVIRONMENT=production

# Cryptographically Secure Random Secret Key for JWT Signing
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_64_character_hex_string_using_openssl_rand_hex_32

# Production Database Connection String
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://skill_user:YourStrongPasswordHere@your-db-host.com:3306/local_skill_exchange?charset=utf8mb4

# CORS Allowed Origins
# Specify comma-separated origins or * for mobile apps
CORS_ORIGINS=*

# Google OAuth Web Client ID (matches the client ID configured in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Automated Seeding on First Deployment (seeds 24 core skills & flagship learning paths)
INIT_SEEDS=true

# Port (managed automatically by cloud providers like Railway, Render, Fly.io)
PORT=8000
